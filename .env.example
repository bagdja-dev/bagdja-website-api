## ─── Server ─────────────────────────────────────────────
PORT=5003
NODE_ENV=development

## ─── Database (Supabase Postgres) ───────────────────────
# Local Supabase (default): postgresql://postgres:postgres@localhost:54342/postgres
# Production: gunakan connection string dari Supabase project.
DATABASE_URL=postgresql://postgres:postgres@localhost:54342/postgres

## ─── Supabase (untuk migrations & storage) ──────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=website-assets

## ─── Bagdja Platform Integration ────────────────────────
# Auth service (JWT validation via JWKS)
BAGDJA_AUTH_API=http://localhost:4001
JWKS_URL=http://localhost:4001/.well-known/jwks.json

# Log service (opsional, non-blocking)
BAGDJA_LOG_URL=http://localhost:4087
BAGDJA_SERVICE_NAME=bagdja-website-api

# Client credentials untuk service-to-service (di-issue oleh bagdja-auth)
CLIENT_APP_ID=website-builder
CLIENT_APP_SECRET=change-me

# Messaging service (staff invitation email)
BAGDJA_MESSAGE_API=https://messaging.bagdja.com
ADMIN_APP_URL=http://localhost:5004
STAFF_INVITATION_TEMPLATE=StaffInvitation

# Payment service (wallet + subscription for Bagdja Website Builder)
BAGDJA_PAYMENT_API=http://localhost:4006

# Host wildcard subdomain renderer publik (bagdja-website), tanpa protokol —
# dipakai untuk bangun base URL successRedirectUrl/failureRedirectUrl per
# tenant saat initialize escrow payment (W2 checkout): https://{slug}.{PLATFORM_HOST}.
# Kalau website punya custom domain terverifikasi, custom domain itu yang dipakai.
PLATFORM_HOST=sites.bagdja.com
# Fallback SAJA kalau resolusi per-tenant di atas gagal (website/slug tidak
# ketemu) — jangan andalkan ini di production multi-tenant.
SITE_APP_URL=http://localhost:5005
# Auto-subscribe new user ke plan free saat login (kalau belum punya subscription). Default true.
AUTO_SUBSCRIBE_FREE_ENABLED=true

## ─── Coolify (custom domain registration untuk web renderer) ─
# Opsional — kalau kosong, CoolifyService no-op (domain tetap ter-verifikasi
# via DNS TXT tapi tidak didaftarkan otomatis ke Coolify; berguna untuk dev lokal).
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_WEB_APP_UUID=

# IP server tempat web renderer publik di-hosting (Coolify) — ditampilkan ke
# tenant sebagai instruksi A record saat setup custom domain. Tanpa ini,
# tenant cuma dapat instruksi TXT (verifikasi kepemilikan) tapi tidak tahu
# harus arahkan domain ke mana supaya benar-benar bisa diakses.
CUSTOM_DOMAIN_TARGET_IP=

## ─── JWT ─────────────────────────────────────────────────
# Secret untuk verifikasi JWT token (sama dengan yang digunakan di bagdja-auth)
JWT_SECRET=your-jwt-secret

## ─── Swagger (Basic Auth) ───────────────────────────────
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me
